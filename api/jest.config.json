{
  "testEnvironment": "node",
  "roots": ["<rootDir>/../tests"],
  "globalSetup": "<rootDir>/jest.setup.ts",
  "transform": {
    "^.+\\.tsx?$": ["ts-jest", { "tsconfig": "<rootDir>/tsconfig.json" }]
  },
  "testRegex": ".*\\.test\\.ts$",
  "moduleFileExtensions": ["ts", "js", "json"],
  "collectCoverageFrom": ["src/**/*.ts"]
}
